# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=crm_os

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-minimum-32-characters-long-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# ai_chatbot_demo integration (WhatsApp goes through the chatbot; the CRM no longer talks to Meta).
# Each secret has the same value as its counterpart on the chatbot side; the events (chatbot -> CRM)
# and send (CRM -> chatbot) secrets must differ. CHATBOT_EVENTS_SECRET_PREVIOUS is only set while
# rotating. CHATBOT_SEND_URL is the chatbot's internal base address (with port, without path).
CHATBOT_EVENTS_SECRET=
CHATBOT_EVENTS_SECRET_PREVIOUS=
CHATBOT_SEND_URL=
CHATBOT_SEND_SECRET=

# Email (IMAP + SMTP) — Google Workspace
# Prerequisites:
#   1. Enable 2-Step Verification on the mailbox account
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#   3. In Google Workspace Admin, enable IMAP access for the user
#      (Apps > Google Workspace > Gmail > End User Access)
# Use the App Password (16 chars, no spaces) for both IMAP_PASSWORD and SMTP_PASSWORD.

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=contact@yourdomain.com
IMAP_PASSWORD=your_app_password
IMAP_POLL_INTERVAL_SECONDS=60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@yourdomain.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=CRM System <contact@yourdomain.com>
